ANTHROPIC_API_KEY=                  # Required — Anthropic API key
LANGCHAIN_API_KEY=                  # Required — LangSmith API key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=trade-finance-compliance
COMPLIANCE_MODEL=claude-sonnet-4-5  # Anthropic model ID; override for testing
CONFIDENCE_THRESHOLD=0.7            # Below this → human review
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
